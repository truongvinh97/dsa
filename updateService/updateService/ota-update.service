[Unit]
Description=OTA Update Service for Blockchain-based Firmware Distribution
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ota/update-service
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

# Load environment variables from .env
EnvironmentFile=/opt/ota/update-service/.env

# Optional: redirect logs
StandardOutput=journal
StandardError=journal

# Optional: limit memory usage
MemoryMax=150M

[Install]
WantedBy=multi-user.target
